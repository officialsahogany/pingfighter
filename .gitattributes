# Keep live Godot runtime binaries out of normal Git blobs.
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf

godot/**/*.gd text eol=lf
godot/**/*.gd.uid text eol=lf
godot/**/*.gdshader text eol=lf
godot/**/*.gdshader.uid text eol=lf
godot/**/*.tscn text eol=lf
godot/**/*.tres text eol=lf
godot/**/*.godot text eol=lf
godot/**/*.import text eol=lf
godot/**/*.json text eol=lf

godot/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.gif filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.wav filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.ogg filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.flac filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.ttf filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.otf filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.zip filter=lfs diff=lfs merge=lfs -text

# Keep editable prologue masters and durable visual-QA evidence out of normal
# Git blobs while leaving them outside the Godot export tree.
art_sources/araul_prologue/**/*.png filter=lfs diff=lfs merge=lfs -text
docs/qa_evidence/araul_prologue_v2/**/*.png filter=lfs diff=lfs merge=lfs -text
docs/qa_evidence/araul_prologue_v3/**/*.png filter=lfs diff=lfs merge=lfs -text
