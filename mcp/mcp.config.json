{
  "$schema": "https://modelcontextprotocol.io/schemas/v0.1/client-config.schema.json",
  "mcpServers": {
    "gemini": {
      "command": "C:\\Program Files\\nodejs\\node.exe",
      "args": [
        "d:\\main\\bosspong\\.claude\\gemini_mcp_launcher.mjs"
      ],
      "transport": "stdio"
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "--directory",
        "~",
        "--directory",
        "/tmp"
      ],
      "transport": "stdio"
    },
    "slack": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_APP_TOKEN": "${SLACK_APP_TOKEN}",
        "SLACK_SIGNING_SECRET": "${SLACK_SIGNING_SECRET}"
      },
      "transport": "stdio"
    },
    "youtube": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-youtube"
      ],
      "env": {
        "YOUTUBE_API_KEY": "${YOUTUBE_API_KEY}"
      },
      "transport": "stdio"
    },
    "elevenlabs": {
      "command": "py",
      "args": [
        "-3",
        "d:\\main\\bosspong\\.claude\\elevenlabs_mcp_launcher.py"
      ],
      "env": {
        "ELEVENLABS_API_KEY": "${ELEVENLABS_API_KEY}",
        "ELEVENLABS_MCP_OUTPUT_MODE": "files",
        "ELEVENLABS_MCP_BASE_PATH": "D:\\main\\bosspong\\generated_audio\\elevenlabs"
      },
      "transport": "stdio"
    }
  }
}
