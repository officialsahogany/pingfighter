{
    "claude-code.autoStart": true,
    "claude-code.autoOpenPanels": 1,
    "claude-code.openOnStartup": true,
    "claude-code.layout.panels": [
        {
            "type": "chat",
            "position": "primary"
        }
    ],
    "claude-code.autoExecute": {
        "enabled": true,
        "commands": [
            "/status",
            "/model opus"
        ],
        "delay": 500
    },
    "claude-code.preferences": {
        "showWelcomeMessage": false,
        "defaultModel": "opus",
        "autoSaveContext": true,
        "contextSaveInterval": 300000
    },
    "claude-code.personas": {
        "default": "refactorer",
        "secondary": "analyzer"
    },
    "files.watcherExclude": {
        "**/._*": true,
        "**/.git/**": true,
        "**/.venv/**": true,
        "**/env/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/__pycache__/**": true,
        "**/images/**": true,
        "**/bgm/**": true,
        "**/sounds/**": true,
        "**/fonts/**": true
    },
    "files.exclude": {
        "**/._*": true,
        "**/__pycache__": true
    },
    "search.exclude": {
        "**/._*": true,
        "**/images/**": true,
        "**/bgm/**": true,
        "**/sounds/**": true,
        "**/fonts/**": true,
        "**/dist/**": true,
        "**/build/**": true
    },
    "python.analysis.exclude": [
        "**/images/**",
        "**/bgm/**",
        "**/sounds/**",
        "**/fonts/**",
        "**/dist/**",
        "**/build/**",
        "**/__pycache__/**"
    ]
}
}
