static func build_configs(tuning: Dictionary) -> Dictionary:
	var configs: Dictionary = {}
	for route_name_value in ROUTE_KEYS:
		var route_name := str(route_name_value)
		var route_keys: Array = ROUTE_KEYS[route_name]
		var route_config: Dictionary = {}
		for key_value in route_keys:
			var key := str(key_value)
			if tuning.has(key):
				route_config[key] = tuning[key]
		configs[route_name] = route_config
	return configs
