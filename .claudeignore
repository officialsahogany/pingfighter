# EVERYTHING except essential source code
*

# Allow only essential files
!*.py
!*.md
!*.txt
!*.json
!*.spec
!*.bat
!*.sh
!*.yml
!*.yaml
!*.toml
!*.cfg
!*.ini

# Allow essential folders (but not their heavy subfolders)
!core/
!core/**/*.py
!game_logic/
!game_logic/**/*.py
!game_mechanics/
!game_mechanics/**/*.py
!entities/
!entities/**/*.py
!ai/
!ai/**/*.py
!managers/
!managers/**/*.py
!ui/
!ui/**/*.py
!rendering/
!rendering/**/*.py
!item_effects/
!item_effects/**/*.py
!events/
!events/**/*.py
!config/
!config/**/*.py
!config/**/*.json
!utils/
!utils/**/*.py
!presentation/
!presentation/**/*.py
!services/
!services/**/*.py
!localization/
!localization/**/*.py
!localization/**/*.json

# Block all heavy folders explicitly
.git/
.venv/
.venv_win/
